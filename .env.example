# ---------------------------------------------------------------------------
# Familiar Ventures — Leopard Mark Ops
# Example environment. Variable NAMES only — never commit real values.
# On Vercel set these as Environment Variables (Production / Preview / Development).
# ---------------------------------------------------------------------------

# Core
FV_ENV=development                 # development | test | production (production disables test selections and dev sign-in)
APP_BASE_URL=http://localhost:3000 # public base URL (OAuth redirect URIs derive from it)
DATABASE_URL=postgres://user:pass@localhost:5432/fv_ops   # Neon: use the pooled connection string
DATABASE_POOL_MAX=5
SESSION_SECRET=change-me-to-a-long-random-string          # >= 16 chars; rotating it signs everyone out
SESSION_COOKIE_HOURS=12            # technical cookie lifetime; authorization is re-checked every request
CRON_SECRET=change-me              # Vercel Cron sends Authorization: Bearer <CRON_SECRET>

# Dev-only fixture sign-in (ignored in production)
DEV_AUTH_BYPASS=false
# DEVELOPMENT DEMO MODE (embedded PGlite + seeded data + auto demo Owner). `npm run demo` sets this.
# Also on automatically when DATABASE_URL is unset in development. Impossible in production/Vercel. FV_DEMO=false forces it off.
FV_DEMO=

# Employee sign-in is company email + PIN (no provider needed). Google sign-in is an OPTIONAL second method:
# leave these blank unless a Google Cloud OAuth 2.0 Web client has been set up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_HD=                 # e.g. theleopardmark.com — restricts Google sign-in to the Workspace domain (optional)

# Stripe (customer association now; invoices/collection in phase 3)
STRIPE_SECRET_KEY=                 # sk_test_... / rk_test_... in test mode; live key only after activation
STRIPE_WEBHOOK_SECRET=             # whsec_... for /api/webhooks/stripe

# Boundary-only in this revision (names reserved; adapters not built)
OPTIMOROUTE_API_KEY=
GMAIL_SENDER_ADDRESS=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GOOGLE_MAPS_API_KEY=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_CHANNEL=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=

# Bootstrap (scripts/bootstrap.ts) — first Owner with a TEMPORARY PIN (must be changed at first sign-in).
# Pass these on the command line for one run rather than keeping them in a file; without OWNER_PIN a random one is printed once.
OWNER_EMAIL=
OWNER_NAME=
OWNER_PIN=
# Break-glass PIN reset (scripts/set-pin.ts): PIN_EMAIL=… PIN=… npm run set-pin
